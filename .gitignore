# =============================================================
# SurgeGuard .gitignore — GitHub Submission Configuration
# =============================================================

# --- Environment & Secrets ---
.env
*.env.local
*.env.*.local

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# --- Databases & Logs ---
*.db
*.sqlite3
feedback.db
*.log
pip-log.txt

# --- Datasets & Predictions (Prevents GitHub 100MB limit rejection) ---
*.csv
train_cleaned.csv
test_cleaned.csv
train.csv
test.csv
test_predictions.csv
predictions.csv

# --- Serialized Models ---
# Ignore general pickles, but explicitly whitelist the required submission artifact
*.pkl
models/*.pkl
!models/risk_engine_artifacts.pkl

# --- Jupyter & IDEs ---
.ipynb_checkpoints/
*.ipynb
.vscode/
.idea/
*.swp
*.swo

# --- Operating System ---
.DS_Store
Thumbs.db
desktop.ini
