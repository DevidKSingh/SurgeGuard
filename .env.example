# =============================================================
# SurgeGuard - Environment Configuration Template
# =============================================================
# Copy this file to .env and fill in your real values.
# .env is gitignored; .env.example is safe to commit.
# =============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=4

# --- CORS ---
ALLOWED_ORIGINS=*

# --- Model Artifacts ---
ARTIFACTS_PATH=risk_engine_artifacts.pkl

# --- Future: Database ---
# DATABASE_URL=postgresql://user:password@localhost:5432/surgeguard
# REDIS_URL=redis://localhost:6379/0

# --- Future: External APIs ---
# FRAUD_INTEL_API_KEY=your_api_key_here
# FRAUD_INTEL_API_URL=https://api.example.com/v1

# --- Future: Authentication ---
# SECRET_KEY=replace_with_a_long_random_string
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
